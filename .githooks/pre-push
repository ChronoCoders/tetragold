#!/usr/bin/env bash
set -uo pipefail
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
. "$root/scripts/lib/checks.sh"

EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904

rc=0
refuse() { echo "pre-push: $1" >&2; rc=1; }

while read -r lref lsha rref rsha; do
    [ -n "${lref:-}" ] || continue
    [ "$(printf '%s' "$lsha" | tr -d 0)" = "" ] && continue

    if [ -z "${rsha:-}" ] || [ "$(printf '%s' "$rsha" | tr -d 0)" = "" ]; then
        commits=$(git rev-list "$lsha" --not --remotes 2>/dev/null) || { refuse "rev-list failed for $lref"; continue; }
        base=""
        for r in $(git for-each-ref --format='%(objectname)' refs/remotes/ 2>/dev/null); do
            b=$(git merge-base "$lsha" "$r" 2>/dev/null) || continue
            [ -n "$b" ] || continue
            if [ -z "$base" ] || git merge-base --is-ancestor "$base" "$b" 2>/dev/null; then
                base="$b"
            fi
        done
        [ -n "$base" ] || base="$EMPTY_TREE"
        diffout=$(git diff "$base" "$lsha" 2>/dev/null) || { refuse "diff failed for $lref"; continue; }
    else
        if ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
            refuse "remote commit $rsha for $lref is unknown locally; fetch and retry"
            continue
        fi
        commits=$(git rev-list "$rsha..$lsha" 2>/dev/null) || { refuse "rev-list failed for $lref"; continue; }
        diffout=$(git diff "$rsha" "$lsha" 2>/dev/null) || { refuse "diff failed for $lref"; continue; }
    fi

    added=$(printf '%s\n' "$diffout" | grep '^+' | grep -v '^+++' || true)

    msgs=""
    for c in $commits; do
        msgs=$(printf '%s\n%s' "$msgs" "$(git log -1 --format='%B' "$c" 2>/dev/null)")
    done

    if [ -n "$commits" ] && ! scan_text_banned_chars "$msgs"; then
        refuse "banned character U+2013 or U+2014 or banned word in a pushed commit message"
    fi
    if ! scan_text_banned_chars "$added"; then
        refuse "banned character U+2013 or U+2014 or banned word in pushed content"
    fi
done

[ $rc -ne 0 ] && echo "pre-push: refused" >&2
exit $rc
