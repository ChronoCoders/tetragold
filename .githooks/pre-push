#!/usr/bin/env bash
# Repo pre-push, run by the global hook via naming_delegate (stdin passed
# through). The global hook already enforces the banned name across pushed
# commit messages, content, paths and tag annotations. This adds only what the
# global layer lacks: a dash sweep over the pushed commit messages and content.

set -uo pipefail
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
. "$root/scripts/lib/checks.sh"

rc=0
while read -r lref lsha rref rsha; do
    [ -n "${lref:-}" ] || continue
    [ "$(printf '%s' "$lsha" | tr -d 0)" = "" ] && continue   # branch deletion
    if [ -z "${rsha:-}" ] || [ "$(printf '%s' "$rsha" | tr -d 0)" = "" ]; then
        # new remote branch: only commits not already on any remote
        commits=$(git rev-list "$lsha" --not --remotes 2>/dev/null || true)
    else
        commits=$(git rev-list "$rsha..$lsha" 2>/dev/null || true)
    fi
    [ -n "$commits" ] || continue

    # messages and content cover the same commit set
    msgs=""
    added=""
    for c in $commits; do
        msgs=$(printf '%s\n%s' "$msgs" "$(git log -1 --format='%B' "$c" 2>/dev/null)")
        added=$(printf '%s\n%s' "$added" "$(git show -U0 --format='' "$c" 2>/dev/null | grep '^+' | grep -v '^+++' || true)")
    done

    if ! scan_text_dashes "$msgs"; then
        echo "pre-push: em or en dash in a pushed commit message" >&2
        rc=1
    fi
    if ! scan_text_dashes "$added"; then
        echo "pre-push: em or en dash in pushed content" >&2
        rc=1
    fi
done

[ $rc -ne 0 ] && echo "pre-push: refused" >&2
exit $rc
