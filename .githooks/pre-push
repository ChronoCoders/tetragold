#!/usr/bin/env bash
set -uo pipefail
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
. "$root/scripts/lib/checks.sh"

EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904

rc=0
refuse() { echo "pre-push: $1" >&2; rc=1; }

GATE_WT=""
GATE_PARENT=""
cleanup_gate() {
    [ -n "$GATE_WT" ] && git worktree remove --force "$GATE_WT" >/dev/null 2>&1
    [ -n "$GATE_PARENT" ] && rm -rf "$GATE_PARENT"
    GATE_WT=""
    GATE_PARENT=""
}
trap cleanup_gate EXIT INT TERM

stage_lib_at() {
    local sha="$1" wt="$2" meta path mode type obj moddir
    while IFS=$'\t' read -r meta path; do
        [ -n "$path" ] || continue
        set -- $meta
        mode="$1"; type="$2"; obj="$3"
        [ "$type" = "commit" ] || continue
        moddir="$root/.git/modules/$path"
        if [ ! -d "$moddir" ]; then
            refuse "gate setup failed: no local module store for $path at $sha"
            return 1
        fi
        if ! git --git-dir="$moddir" cat-file -e "$obj^{commit}" 2>/dev/null; then
            refuse "gate setup failed: $path commit $obj for $sha is not local; fetch and retry"
            return 1
        fi
        mkdir -p "$wt/$path"
        if ! git --git-dir="$moddir" archive "$obj" | tar -x -C "$wt/$path"; then
            refuse "gate setup failed: could not stage $path at $sha"
            return 1
        fi
    done < <(git ls-tree "$sha" lib/ 2>/dev/null)
    return 0
}

gate_at() {
    local sha="$1" out g
    GATE_PARENT=$(mktemp -d 2>/dev/null) || { refuse "gate setup failed: no temp dir for $sha"; return 1; }
    GATE_WT="$GATE_PARENT/wt"
    if ! git worktree add --detach "$GATE_WT" "$sha" >/dev/null 2>&1; then
        refuse "gate setup failed: no worktree at $sha"
        cleanup_gate
        return 1
    fi
    if ! stage_lib_at "$sha" "$GATE_WT"; then
        cleanup_gate
        return 1
    fi
    out=$(cd "$GATE_WT" && ./scripts/gate 2>&1)
    g=$?
    cleanup_gate
    if [ "$g" -ne 0 ]; then
        refuse "gate failed at $sha"
        printf '%s\n' "$out" | sed 's/^/    /' >&2
        return 1
    fi
    return 0
}

while read -r lref lsha rref rsha; do
    [ -n "${lref:-}" ] || continue
    [ "$(printf '%s' "$lsha" | tr -d 0)" = "" ] && continue

    if [ -z "${rsha:-}" ] || [ "$(printf '%s' "$rsha" | tr -d 0)" = "" ]; then
        commits=$(git rev-list "$lsha" --not --remotes 2>/dev/null) || { refuse "rev-list failed for $lref"; continue; }
        base=""
        for r in $(git for-each-ref --format='%(objectname)' refs/remotes/ 2>/dev/null); do
            b=$(git merge-base "$lsha" "$r" 2>/dev/null) || continue
            [ -n "$b" ] || continue
            if [ -z "$base" ] || git merge-base --is-ancestor "$base" "$b" 2>/dev/null; then
                base="$b"
            fi
        done
        [ -n "$base" ] || base="$EMPTY_TREE"
        diffout=$(git diff "$base" "$lsha" 2>/dev/null) || { refuse "diff failed for $lref"; continue; }
    else
        if ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
            refuse "remote commit $rsha for $lref is unknown locally; fetch and retry"
            continue
        fi
        commits=$(git rev-list "$rsha..$lsha" 2>/dev/null) || { refuse "rev-list failed for $lref"; continue; }
        diffout=$(git diff "$rsha" "$lsha" 2>/dev/null) || { refuse "diff failed for $lref"; continue; }
    fi

    added=$(printf '%s\n' "$diffout" | grep '^+' | grep -v '^+++' || true)

    msgs=""
    for c in $commits; do
        msgs=$(printf '%s\n%s' "$msgs" "$(git log -1 --format='%B' "$c" 2>/dev/null)")
    done

    if [ -n "$commits" ] && ! scan_text_banned_chars "$msgs"; then
        refuse "banned character U+2013 or U+2014 or banned word in a pushed commit message"
    fi
    if ! scan_text_banned_chars "$added"; then
        refuse "banned character U+2013 or U+2014 or banned word in pushed content"
    fi

    gate_at "$lsha"
done

[ $rc -ne 0 ] && echo "pre-push: refused" >&2
exit $rc
