#!/usr/bin/env bash
set -uo pipefail
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
. "$root/scripts/lib/checks.sh"

rc=0

banned_char_selftest || { echo "pre-commit: character detector failed its self test" >&2; exit 1; }
banned_word_selftest || { echo "pre-commit: word detector failed its self test" >&2; exit 1; }

while IFS= read -r f; do
    [ -n "$f" ] || continue
    if scan_blob_banned_chars "$f" >/dev/null; then
        echo "pre-commit: banned character U+2013 or U+2014 or banned word in staged $f" >&2
        rc=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

if ! "${FORGE:-$HOME/.foundry/bin/forge}" fmt --check >/dev/null 2>&1; then
    echo "pre-commit: forge fmt --check failed" >&2
    rc=1
fi

[ $rc -ne 0 ] && echo "pre-commit: refused" >&2
exit $rc
