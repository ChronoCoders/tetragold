#!/usr/bin/env bash
set -uo pipefail
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
. "$root/scripts/lib/checks.sh"

msg_file="$1"
rc=0

body=$(grep -cvE '^[[:space:]]*($|#)' "$msg_file")
if [ "$body" -ne 1 ]; then
    echo "commit-msg: the message must be a single line, no body" >&2
    rc=1
fi

subject=$(grep -vE '^[[:space:]]*($|#)' "$msg_file" | head -1)
if ! printf '%s' "$subject" | grep -qE '^(feat|fix|docs|test|refactor|chore): .'; then
    echo "commit-msg: subject needs a conventional prefix (feat|fix|docs|test|refactor|chore)" >&2
    rc=1
fi

if ! scan_text_banned_chars "$subject"; then
    echo "commit-msg: subject contains a banned character U+2013 or U+2014 or banned word" >&2
    rc=1
fi

cleanup_selftest || { echo "commit-msg: cleanup detector failed its self test" >&2; exit 1; }
if is_cleanup_subject "$subject"; then
    echo "commit-msg: subject describes a formatting or cleanup change; it must ride a real change" >&2
    rc=1
fi

[ $rc -ne 0 ] && echo "commit-msg: refused" >&2
exit $rc
