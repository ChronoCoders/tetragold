#!/usr/bin/env bash
set -uo pipefail

export LC_ALL=C.UTF-8

root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "gate: not a git repo"; exit 1; }
cd "$root"

FORGE="${FORGE:-$HOME/.foundry/bin/forge}"
rc=0

pass() { echo "PASS $1"; }
fail() { echo "FAIL $1"; rc=1; }

want=$(cat foundry-version)
have=$("$FORGE" --version 2>&1 | grep -E '^(forge Version|Commit SHA):')
if [ "$want" != "$have" ]; then
    fail "toolchain"
    echo "  pinned in foundry-version:"
    printf '%s\n' "$want" | sed 's/^/    /'
    echo "  reported by forge --version:"
    printf '%s\n' "$have" | sed 's/^/    /'
    exit $rc
fi
pass "toolchain"

. scripts/lib/checks.sh

if "$FORGE" fmt --check >/dev/null 2>&1; then pass "fmt"; else fail "fmt"; fi

if "$FORGE" build -D warnings --no-lint >/dev/null 2>&1; then pass "build"; else fail "build"; fi

lint_out=$("$FORGE" lint src script test -D notes 2>&1); lint_rc=$?
warns=$(printf '%s\n' "$lint_out" | grep -c 'warning\[')
notes=$(printf '%s\n' "$lint_out" | grep -c 'note\[')
echo "  lint findings: $warns warning lines, $notes note lines (deny=notes)"
if [ "$lint_rc" -eq 0 ]; then pass "lint"; else fail "lint (exit $lint_rc)"; fi

if "$FORGE" test >/dev/null 2>&1; then pass "test"; else fail "test"; fi

msgs=$(git log --all --format='%H%n%B' 2>/dev/null || true)

char_report=$(scan_tracked_banned_chars); char_rc=$?
if scan_text_banned_chars "$msgs"; then cmsg_rc=0; else cmsg_rc=1; fi
if [ "$char_rc" -eq 0 ] && [ "$cmsg_rc" -eq 0 ]; then
    pass "banned character sweep"
else
    printf '%s\n' "$char_report"
    [ "$cmsg_rc" -ne 0 ] && echo "  banned character or word in a commit message"
    fail "banned character sweep"
fi

name_report=$(scan_tracked_name); name_rc=$?
if scan_text_name "$msgs"; then nmsg_rc=0; else nmsg_rc=1; fi
if [ "$name_rc" -eq 0 ] && [ "$nmsg_rc" -eq 0 ]; then
    pass "name sweep"
else
    printf '%s\n' "$name_report"
    [ "$nmsg_rc" -ne 0 ] && echo "  banned name in a commit message"
    fail "name sweep"
fi

exit $rc
