# ---- Shared chain config ----
RPC_URL=http://localhost:8545
# Optional: a second RPC used as failover if RPC_URL stops responding.
RPC_URL_FALLBACK=
CHAIN_ID=31337

# ---- Contract addresses ----
ORACLE=
VAULT=
POOL=
LIQUIDATION_ENGINE=
INSURANCE=
TGAUX=

# ---- Keeper only ----
# Private key of a FUNDED EOA. The keeper needs gas only; no protocol roles are
# required (markForLiquidation / liquidatePosition / performUpkeep / updateTwap
# are all permissionless). NEVER commit a real key. Prefer a secrets manager in
# production and pass this in at runtime.
KEEPER_PRIVATE_KEY=

# Keeper behaviour
KEEPER_DRY_RUN=true               # log intended txs but never send them
KEEPER_ONCE=false                 # run one tick and exit (cron-style / tests) instead of looping
KEEPER_POLL_SECONDS=15            # main loop cadence
ORACLE_MAX_STALENESS_SECONDS=300  # refresh TWAP once the cached price is older than this
ORACLE_MIN_UPDATE_INTERVAL=60     # on-chain MIN_UPDATE_INTERVAL; keeper will not call sooner
MAX_LIQUIDATIONS_PER_TICK=10      # matches on-chain MAX_LIQUIDATIONS_PER_UPKEEP
TX_CONFIRMATIONS=1
GAS_LIMIT_MULTIPLIER=1.25         # headroom over estimateGas
# performUpkeep swallows inner liquidation reverts (try/catch), so estimateGas
# returns the inner-OOG-then-caught minimum and would starve the real work.
# Gas is sized explicitly: base + per-position, per the positions in performData.
PERFORM_UPKEEP_BASE_GAS=200000
PERFORM_UPKEEP_GAS_PER_POSITION=800000
KEEPER_METRICS_PORT=9101

# ---- Exporter only ----
EXPORTER_PORT=9102
EXPORTER_SCRAPE_SECONDS=15
# Cap on how many active positions to enumerate per scrape (pagination guard).
EXPORTER_MAX_POSITIONS=200

# ---- Public read API ----
API_PORT=8080
# Comma-separated API keys accepted on /v1/*. Generate strong random values and
# keep them in a secrets manager. Leave empty only if API_AUTH_DISABLED=true.
API_KEYS=
API_AUTH_DISABLED=false            # disable auth entirely (local/dev only)
API_RATE_LIMIT_MAX=120             # requests per window, per API key
API_RATE_LIMIT_WINDOW_SECONDS=60
API_CACHE_TTL_SECONDS=5            # TTL for cached live on-chain snapshot
API_SUBGRAPH_URL=http://localhost:8000/subgraphs/name/tetragold/tetragold
API_SUBGRAPH_TIMEOUT_MS=10000
API_MAX_POSITIONS=200              # pagination guard for the live snapshot
API_CORS_ORIGIN=*                  # tighten to your frontend origin in production
API_GRAPHQL_PASSTHROUGH=true       # expose POST /v1/graphql to the subgraph

# ---- Logging ----
LOG_LEVEL=info                    # debug | info | warn | error
LOG_FORMAT=json                   # json | pretty
