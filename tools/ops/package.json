{
  "name": "tetragold-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tetra Gold operations: liquidation/oracle keeper bot, read-only Prometheus exporter, and public read API.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "keeper": "tsx src/keeper.ts",
    "exporter": "tsx src/exporter.ts",
    "api": "tsx src/api.ts",
    "start:keeper": "node dist/keeper.js",
    "start:exporter": "node dist/exporter.js",
    "start:api": "node dist/api.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "prom-client": "^15.1.3",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^20.16.0"
  }
}
